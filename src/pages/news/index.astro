---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { url } from '../../lib/url';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const [featured, ...rest] = posts;

// Group the remainder by year so a decade of archives stays scannable.
const byYear = new Map<number, typeof rest>();
for (const post of rest) {
  const y = post.data.date.getUTCFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
---

<BaseLayout
  title="News"
  description="Announcements, meeting recaps, ballot positions, and commentary from the Libertarian Party of Travis County."
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">News &amp; announcements</span>
      <h1>What's new at LP Travis</h1>
      <p class="lede">
        Meeting announcements, ballot measure positions, convention news, and
        commentary on liberty in Travis County.
        <a href={`${base}/rss.xml`}>Subscribe via RSS</a>.
      </p>
    </div>
  </section>

  {featured && (
    <section class="wrap featured-wrap">
      <a class:list={['featured', { 'no-image': !featured.data.image }]} href={`${base}/news/${featured.id}`}>
        {featured.data.image && (
          <img src={url(featured.data.image)} alt="" loading="eager" decoding="async" />
        )}
        <div class="featured-body">
          <span class="eyebrow">Most recent</span>
          <h2>{featured.data.title}</h2>
          <time datetime={featured.data.date.toISOString()}>{fmt(featured.data.date)}</time>
          {featured.data.description && <p>{featured.data.description}</p>}
          <span class="more">Read the full post &rarr;</span>
        </div>
      </a>
    </section>
  )}

  {years.map((year) => (
    <section class="section year-section">
      <div class="wrap">
        <h2 class="year">{year}</h2>
        <div class="grid grid-3">
          {byYear.get(year)!.map((post) => (
            <NewsCard
              href={`${base}/news/${post.id}`}
              title={post.data.title}
              date={post.data.date}
              description={post.data.description}
              image={post.data.image}
              tags={post.data.tags}
            />
          ))}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .page-head {
    background: var(--surface-alt);
    border-bottom: 1px solid var(--line);
    padding: clamp(2.5rem, 6vw, 4rem) 0;
  }
  .page-head h1 { margin-bottom: 0.6rem; }
  .page-head .lede { max-width: 62ch; margin: 0; }

  .featured-wrap { margin-top: clamp(2rem, 5vw, 3rem); }

  .featured {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.18s ease, transform 0.18s ease;
  }
  .featured:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }

  .featured.no-image { grid-template-columns: 1fr; }

  .featured img {
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
    background: var(--surface-alt);
  }

  .featured-body { padding: clamp(1.5rem, 3.5vw, 2.4rem); }
  .featured-body h2 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    margin-bottom: 0.4rem;
    color: var(--ink);
  }
  .featured-body time {
    display: block;
    font-size: 0.86rem;
    color: var(--muted);
    margin-bottom: 0.9rem;
  }
  .featured-body p { color: var(--body); font-size: 1rem; }
  .more { font-weight: 650; color: var(--gold-deep); font-size: 0.93rem; }

  .year-section { padding: clamp(2.2rem, 5vw, 3rem) 0 0; }
  .year-section:last-of-type { padding-bottom: 2rem; }

  .year {
    font-size: 1.1rem;
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--muted);
    padding-bottom: 0.7rem;
    margin-bottom: 1.6rem;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 820px) {
    .featured { grid-template-columns: 1fr; }
    .featured img { min-height: 200px; aspect-ratio: 16 / 9; }
  }
</style>
