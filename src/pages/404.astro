---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Page not found" description="That page could not be found.">
  <section class="nf">
    <div class="wrap-narrow">
      <span class="eyebrow">404</span>
      <h1>We can't find that page</h1>
      <p class="lede">
        The link may be out of date — this site replaced our old WordPress site,
        and a few addresses changed along the way.
      </p>
      <div class="acts">
        <a class="btn btn-primary" href={`${base}/`}>Go to the homepage</a>
        <a class="btn btn-outline" href={`${base}/news`}>Browse the news</a>
        <a class="btn btn-outline" href={`${base}/archive`}>See the full archive</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { padding: clamp(3rem, 10vw, 7rem) 0; text-align: center; }
  .nf h1 { margin-bottom: 0.7rem; }
  .nf .lede { max-width: 50ch; margin: 0 auto 1.8rem; }
  .acts { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; }
</style>
