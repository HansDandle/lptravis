---
import { url } from '../lib/url';
interface Props {
  href: string;
  title: string;
  date: Date;
  description?: string;
  image?: string;
  tags?: string[];
}

const { href, title, date, description, image, tags = [] } = Astro.props;
const imageUrl = image ? url(image) : undefined;

const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<article class="card post">
  <a class="cover-link" href={href} tabindex="-1" aria-hidden="true">
    {imageUrl ? (
      <img class="cover" src={imageUrl} alt="" loading="lazy" decoding="async" />
    ) : (
      <div class="cover cover-fallback"><span>LP</span></div>
    )}
  </a>
  <div class="body">
    <div class="meta">
      <time datetime={date.toISOString()}>{formatted}</time>
      {tags.length > 0 && <span class="tag">{tags[0]}</span>}
    </div>
    <h3><a href={href}>{title}</a></h3>
    {description && <p class="desc">{description}</p>}
    <span class="more" aria-hidden="true">Read more &rarr;</span>
  </div>
</article>

<style>
  .post { display: flex; flex-direction: column; height: 100%; }

  .cover-link { display: block; }

  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--surface-alt);
  }

  .cover-fallback {
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--navy), var(--navy-soft));
  }
  .cover-fallback span {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    color: var(--gold);
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem 1.35rem 1.4rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 0.55rem;
  }

  .tag {
    background: var(--surface-alt);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }

  h3 {
    font-size: 1.16rem;
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { color: var(--gold-deep); }

  .desc {
    font-size: 0.94rem;
    color: var(--body);
    margin: 0 0 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .more {
    margin-top: auto;
    font-size: 0.88rem;
    font-weight: 650;
    color: var(--gold-deep);
  }
</style>
