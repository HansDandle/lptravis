---
import { site, meeting, links } from '../site.config';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();

const social = [
  { label: 'Facebook Page', href: links.facebookPage },
  { label: 'Facebook Group', href: links.facebookGroup },
  { label: 'Twitter / X', href: links.twitter },
  { label: 'Instagram', href: links.instagram },
  { label: 'Meetup', href: links.meetup },
];
---

<footer class="site-footer">
  <div class="wrap cols">
    <div class="col about">
      <div class="brand">
        <span class="brand-mark" aria-hidden="true">LP</span>
        <strong>Libertarian Party of Travis County</strong>
      </div>
      <p class="blurb">{site.description}</p>
      <a class="btn btn-primary" href={links.donate} target="_blank" rel="noopener">
        Donate to LP Travis
      </a>
    </div>

    <div class="col">
      <h2>Monthly meeting</h2>
      <p class="meet">
        {meeting.cadence}<br />
        {meeting.time}<br />
        <a href={meeting.mapUrl} target="_blank" rel="noopener">{meeting.venue}</a><br />
        <span class="dim">{meeting.address}</span>
      </p>
    </div>

    <div class="col">
      <h2>Explore</h2>
      <ul>
        <li><a href={`${base}/about`}>About us</a></li>
        <li><a href={`${base}/news`}>News</a></li>
        <li><a href={`${base}/events`}>Events &amp; calendar</a></li>
        <li><a href={`${base}/get-involved`}>Get involved</a></li>
        <li><a href={`${base}/bylaws`}>Bylaws</a></li>
        <li><a href={`${base}/archive`}>Archive</a></li>
        <li><a href={`${base}/contact`}>Contact</a></li>
      </ul>
    </div>

    <div class="col">
      <h2>Follow</h2>
      <ul>
        {social.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>
        ))}
        <li><a href={links.newsletter} target="_blank" rel="noopener">Austin Liberator</a></li>
        <li><a href={`${base}/rss.xml`}>RSS feed</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap legal">
    <p>&copy; {year} Libertarian Party of Travis County. Affiliated with the
      <a href={links.lpTexas} target="_blank" rel="noopener">Libertarian Party of Texas</a> and the
      <a href={links.lpNational} target="_blank" rel="noopener">national Libertarian Party</a>.
    </p>
    <p class="dim">Political advertising paid for by the Libertarian Party of Travis County.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: #aab3c6;
    padding: clamp(2.5rem, 6vw, 4rem) 0 1.5rem;
    margin-top: 4rem;
  }

  .cols {
    display: grid;
    gap: 2.2rem;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
  }

  .about .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: var(--gold);
    color: #16181d;
    font-weight: 800;
    flex-shrink: 0;
  }
  .about .brand strong {
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.25;
  }

  .blurb {
    font-size: 0.93rem;
    line-height: 1.65;
    margin-bottom: 1.3rem;
    max-width: 42ch;
  }

  h2 {
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    margin: 0 0 0.9rem;
  }

  ul { list-style: none; margin: 0; padding: 0; }
  li { margin-bottom: 0.5rem; }

  .site-footer a { color: #d6dce8; text-decoration: none; font-size: 0.93rem; }
  .site-footer a:hover { color: var(--gold); text-decoration: underline; }
  .site-footer .btn-primary { color: #16181d; font-size: 0.95rem; }
  .site-footer .btn-primary:hover { color: #16181d; text-decoration: none; }

  .meet { font-size: 0.93rem; line-height: 1.8; margin: 0; }
  .dim { color: #818b9e; }

  .legal {
    margin-top: 2.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .legal p { font-size: 0.84rem; margin: 0 0 0.35rem; }

  @media (max-width: 860px) {
    .cols { grid-template-columns: 1fr 1fr; }
    .about { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .cols { grid-template-columns: 1fr; }
  }
</style>
